<div class="col">
 
  <a href="{% if cours.redirect %}{{ cours.redirect }}{% else %}{{ cours.cours_coll | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if cours.img %}
        {%
          include figure.liquid
          loading="eager"
          path=cours.img
          sizes = "250px"
          alt="cours thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ cours.title }}</h2>
        <p class="card-text">{{ cours.description }}</p>
        <div class="row ml-1 mr-1 p-0">
          {% if cours.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ cours.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if cours.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ cours.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </a>
</div>
